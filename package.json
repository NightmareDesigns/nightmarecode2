{
  "name": "nightmarecode2",
  "version": "0.1.0",
  "description": "Nightmare Designs Code - dark code editor with Matrix aesthetic",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --dir",
    "dist": "electron-builder",
    "package": "electron-builder --win portable",
    "android:sync": "cap sync android",
    "android:apk": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "keywords": [
    "editor",
    "desktop",
    "matrix",
    "code"
  ],
  "author": "NightmareDesigns",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.nightmaredesigns.nightmarecode2",
    "productName": "Nightmare Designs Code",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/.git/**",
      "!android/**",
      "!capacitor.config.json",
      "!**/dist/**",
      "!**/node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NightmareDesignsCode-${version}-portable.exe"
    }
  }
}
